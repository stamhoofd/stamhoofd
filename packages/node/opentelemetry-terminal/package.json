{
    "name": "@node/opentelemetry-terminal",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": { ".": { "types": "./dist-types/index.d.ts", "default": "./dist/index.js" } },
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint . --quiet",
        "test": "vitest run",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "chalk": "5.6.2",
        "@common/opentelemetry-decorators": "workspace:*",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/sdk-trace": "3.0.0",
        "@node/terminal": "workspace:*",
        "tslib": "2.8.1"
    },
    "devDependencies": { "eslint-plugin-stamhoofd": "workspace:*", "vitest": "4.1.12", "@opentelemetry/sdk-node": "0.300.0" }
}
