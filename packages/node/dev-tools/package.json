{
    "name": "@node/dev-tools",
    "version": "2.158.0",
    "private": true,
    "type": "module",
    "exports": {
        "./*": {
            "types": "./dist-types/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint . --quiet"
    },
    "dependencies": {
        "concurrently": "10.0.6",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@nuxt/schema": "4.6.3",
        "vite": "8.3.6"
    }
}
