{
    "name": "@stamhoofd/node-dev-tools",
    "version": "2.158.0",
    "type": "module",
    "files": [
        "dist",
        "dist-types"
    ],
    "exports": {
        "./*": {
            "types": "./dist-types/*.d.ts",
            "import": "./dist/*.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint . --quiet"
    },
    "dependencies": {
        "concurrently": "10.0.7",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@nuxt/schema": "4.6.4",
        "vite": "8.3.8"
    },
    "peerDependencies": {
        "@nuxt/schema": "4.6.4",
        "vite": "8.3.8"
    },
    "peerDependenciesMeta": {
        "@nuxt/schema": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
