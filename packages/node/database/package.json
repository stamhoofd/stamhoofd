{
    "name": "@node/database",
    "version": "1.40.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./migrations/*": "./migrations/*",
        "./data/*": {
            "types": "./dist-types/src/classes/data/*.d.ts",
            "import": "./dist/src/classes/data/*.mjs",
            "require": "./dist/src/classes/data/*.cjs"
        }
    },
    "imports": {
        "#migrations/*": "./migrations/*"
    },
    "scripts": {
        "build": "tsdown",
        "build:types": "tsc --project tsconfig.types.json",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --quiet"
    },
    "dependencies": {
        "@node/logging": "workspace:*",
        "@common/encoding": "workspace:*",
        "mysql2": "3.24.6",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@common/errors": "workspace:*",
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "tsdown": "0.21.4",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vitest": "4.1.12"
    }
}
