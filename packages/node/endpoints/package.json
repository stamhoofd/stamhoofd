{
    "name": "@simonbackx/simple-endpoints",
    "version": "1.23.0",
    "type": "module",
    "types": "./dist/esm/index.d.ts",
    "module": "./dist/esm/index.js",
    "main": "./dist/cjs/index.js",
    "exports": {
        ".": {
            "types": "./dist/esm/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsc --build tsconfig.cjs.json tsconfig.esm.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
        "lint": "eslint",
        "test": "vitest",
        "prepublishOnly": "pnpm build"
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "@simonbackx/simple-encoding": "^2.26.0",
        "@simonbackx/simple-errors": "^1.5.0"
    },
    "devDependencies": {
        "@simonbackx/simple-encoding": "^2.26.11",
        "@simonbackx/simple-errors": "^1.5.0",
        "@types/node": "^25.5.0",
        "eslint": "^9",
        "eslint-plugin-stamhoofd": "^2.153.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.1"
    },
    "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
