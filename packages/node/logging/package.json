{
    "name": "@node/logging",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "version": "1.0.1",
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --quiet"
    },
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "chalk": "4.1.2",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "eslint-plugin-stamhoofd": "workspace:*",
        "vitest": "4.1.12"
    }
}
