{
    "name": "@common/errors",
    "version": "1.5.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "license": "UNLICENCED",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --quiet"
    },
    "dependencies": {
        "tslib": "2.8.1",
        "uuid": "11.1.1"
    },
    "devDependencies": {
        "@simonbackx/simple-encoding": "2.26.11",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vitest": "4.1.12"
    },
    "peerDependencies": {
        "@simonbackx/simple-encoding": "2.26.11"
    }
}
