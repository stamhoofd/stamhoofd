{
    "name": "@stamhoofd/common-opentelemetry-decorators",
    "version": "0.1.0",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "dist-types"
    ],
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "lint": "oxlint . --quiet --type-aware --threads 2",
        "test": "vitest run"
    },
    "dependencies": {
        "@opentelemetry/api": "1.10.0",
        "tslib": "2.9.1"
    },
    "devDependencies": {
        "oxlint-plugin-stamhoofd": "workspace:*",
        "@opentelemetry/sdk-node": "0.301.2",
        "@opentelemetry/sdk-trace": "3.1.1",
        "vitest": "4.1.12",
        "eslint-plugin-stamhoofd": "workspace:*"
    },
    "publishConfig": {
        "access": "public"
    }
}
