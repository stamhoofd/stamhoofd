        "eslint-plugin-stamhoofd": "^2.74.0",
        "playwright": "1.60.0",
        "sass": "^1.32.4",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^6.0.0",
        "vite-plugin-dts": "^4.0.0",
        "vitest": "^4.1.8",
        "vue": "^3.5.12",
        "vue-tsc": "^3.2.6"
    },
