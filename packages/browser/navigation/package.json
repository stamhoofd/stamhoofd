{
    "name": "@browser/navigation",
    "version": "2.25.1",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": [
        "*.vue",
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./dist/main.css": "./dist/main.css"
    },
    "scripts": {
        "build": "vite build",
        "build:types": "vue-tsc --project tsconfig.types.json",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint . --quiet"
    },
    "dependencies": {
        "@vue/shared": "3.5.44",
        "vue": "3.5.44",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@vue/runtime-core": "3.5.44",
        "@vitejs/plugin-vue": "5.2.4",
        "@vitest/browser-playwright": "4.1.12",
        "playwright": "1.64.1",
        "sass": "1.105.0",
        "vite": "6.4.4",
        "vue-tsc": "3.3.11",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vitest": "4.1.12"
    }
}
