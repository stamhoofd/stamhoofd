{
    "name": "@simonbackx/vue-app-navigation",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "version": "2.25.1",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./dist/main.css": {
            "import": "./dist/main.css"
        }
    },
    "sideEffects": [
