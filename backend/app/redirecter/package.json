{
    "name": "@stamhoofd/redirecter",
    "version": "2.153.5",
    "type": "module",
    "main": "index.ts",
    "scripts": {
        "build": "tsc --build tsconfig.build.json && pnpm run copy-assets",
        "build:full": "rm -rf ./dist && rm -f *.tsbuildinfo && pnpm run build",
        "copy-assets": "rsync --delete --mkpath --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/ ./dist/",
        "lint": "eslint",
        "start": "pnpm run build && node ./dist/index.js",
        "typecheck": "tsc --build tsconfig.test.json",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@simonbackx/simple-database": "1.40.1",
        "@simonbackx/simple-endpoints": "1.22.0",
        "@simonbackx/simple-logging": "1.0.1",
        "@stamhoofd/backend-env": "workspace:*",
        "@stamhoofd/backend-middleware": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.4"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@types/node": "22.20.4",
        "nock": "14.0.17",
        "vitest": "4.1.11"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
