{
    "name": "@stamhoofd/redirecter",
    "version": "2.156.0",
    "type": "module",
    "main": "index.ts",
    "types": "./dist-types/index.d.ts",
    "files": [
        "dist",
        "dist-types",
        "src",
        "*.ts",
        "tsconfig*.json"
    ],
    "scripts": {
        "build:types": "tsc --project tsconfig.types.json",
        "build": "tsc --build tsconfig.build.json && pnpm run copy-assets",
        "build:full": "rm -rf ./dist && rm -f *.tsbuildinfo .cache/*.tsbuildinfo && pnpm run build",
        "copy-assets": "rsync --delete --mkpath --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/ ./dist/",
        "lint": "eslint --quiet",
        "start": "pnpm run build && node ./dist/index.js",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@node/database": "workspace:*",
        "@node/endpoints": "workspace:*",
        "@node/logging": "workspace:*",
        "@stamhoofd/backend-env": "workspace:*",
        "@stamhoofd/backend-middleware": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.6"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@types/node": "22.20.4",
        "nock": "14.0.17",
        "vitest": "4.1.12"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
