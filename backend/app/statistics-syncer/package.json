{
    "name": "@stamhoofd/backend-statistics-syncer",
    "version": "2.152.0",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc --build tsconfig.build.json && mkdir -p ./dist/src/migrations && rsync --delete --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/migrations/ ./dist/src/migrations/",
        "build:watch": "pnpm run build && tsc --build tsconfig.build.json --watch --preserveWatchOutput",
        "build:full": "pnpm run clear && pnpm run build",
        "clear": "rm -rf ./dist && rm -f *.tsbuildinfo",
        "dev": "wait-on ../../shared/middleware/dist/index.js && concurrently -r 'pnpm run build:watch' \"wait-on ./dist/index.js && nodemon --quiet --inspect=5859 --watch dist --watch '../../../shared/*/dist/' --watch '../../shared/*/dist/' --ext .ts,.json,.sql,.js --watch .env.json --delay 1000ms --exec 'node --enable-source-maps ./dist/index.js' --signal SIGTERM\"",
        "lint": "eslint",
        "migrations": "pnpm run build:full && node ./dist/migrations.js",
        "start": "pnpm run build && node --enable-source-maps ./dist/index.js",
        "typecheck": "tsc --build tsconfig.test.json",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@simonbackx/simple-database": "1.40.1",
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-errors": "1.5.0",
        "@simonbackx/simple-logging": "1.0.1",
        "@stamhoofd/backend-env": "2.152.0",
        "@stamhoofd/crons": "2.152.0",
        "@stamhoofd/logging": "2.152.0",
        "@stamhoofd/models": "2.152.0",
        "@stamhoofd/queues": "2.152.0",
        "@stamhoofd/sql": "2.152.0",
        "@stamhoofd/structures": "2.152.0",
        "@stamhoofd/types": "2.152.0",
        "@stamhoofd/utility": "2.152.0",
        "mysql2": "3.24.4"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "2.152.0",
        "@types/node": "22.20.1",
        "vitest": "4.1.11"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
