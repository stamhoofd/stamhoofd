{
    "name": "@stamhoofd/backend-statistics-syncer",
    "version": "2.158.0",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "require": "./dist/index.js"
        }
    },
    "types": "./dist-types/index.d.ts",
    "files": [
        "dist",
        "dist-types",
        "src",
        "*.ts",
        "tsconfig*.json"
    ],
    "scripts": {
        "build:types": "tsc --project tsconfig.types.json",
        "build": "tsc --build tsconfig.build.json && mkdir -p ./dist/src/migrations && rsync --delete --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/migrations/ ./dist/src/migrations/",
        "build:full": "pnpm run clear && pnpm run build",
        "clear": "rm -rf ./dist && rm -f *.tsbuildinfo .cache/*.tsbuildinfo",
        "lint": "eslint --quiet",
        "migrations": "pnpm run build:full && node ./dist/migrations.js",
        "start": "pnpm run build && node --enable-source-maps ./dist/index.js",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@node/observability": "workspace:*",
        "@common/encoding": "workspace:*",
        "@common/errors": "workspace:*",
        "@node/database": "workspace:*",
        "@node/logging": "workspace:*",
        "@stamhoofd/backend-env": "workspace:*",
        "@stamhoofd/crons": "workspace:*",
        "@stamhoofd/logging": "workspace:*",
        "@stamhoofd/models": "workspace:*",
        "@stamhoofd/queues": "workspace:*",
        "@stamhoofd/sql": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.6"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@types/node": "22.20.4",
        "vitest": "4.1.12"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
