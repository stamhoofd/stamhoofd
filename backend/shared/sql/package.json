{
    "name": "@stamhoofd/sql",
    "version": "2.156.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "dist-types"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint --quiet",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@simonbackx/simple-database": "1.40.1",
        "@simonbackx/simple-encoding": "2.26.11",
        "@common/errors": "workspace:*",
        "@simonbackx/simple-logging": "1.0.1",
        "@stamhoofd/filters": "workspace:*",
        "lru-cache": "11.5.3"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.6",
        "vitest": "4.1.12"
    },
    "peerDependencies": {
        "@stamhoofd/utility": "workspace:*"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
