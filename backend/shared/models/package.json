{
    "name": "@stamhoofd/models",
    "version": "2.156.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": [
        "./src/models/_relations.ts",
        "./dist/models/_relations.js"
    ],
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.ts": {
            "types": "./dist-types/*.d.ts",
            "default": "./dist/*.js"
        },
        "./*.js": {
            "types": "./dist-types/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "imports": {
        "#*": "./src/*.ts",
        "#*.ts": "./src/*.ts"
    },
    "files": [
        "dist",
        "dist-types",
        "src"
    ],
    "scripts": {
        "build:types": "tsc --project tsconfig.types.json",
        "build": "tsc --build tsconfig.build.json && mkdir -p ./dist/migrations && rsync --delete --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/migrations/ ./dist/migrations/ && rsync -r --checksum ./src/assets/ ./dist/assets/",
        "lint": "eslint --quiet",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1152.0",
        "@aws-sdk/client-sesv2": "3.1152.0",
        "@bwip-js/node": "4.11.4",
        "@simonbackx/simple-database": "1.40.1",
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-endpoints": "1.23.0",
        "@simonbackx/simple-errors": "1.5.0",
        "argon2": "0.45.1",
        "base-x": "3.0.11",
        "handlebars": "4.7.10",
        "luxon": "3.7.2",
        "sharp": "0.35.5",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@stamhoofd/backend-i18n": "workspace:*",
        "@stamhoofd/email": "workspace:*",
        "@stamhoofd/queues": "workspace:*",
        "@stamhoofd/sql": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "@types/luxon": "3.7.6",
        "@types/uuid": "8.3.4",
        "mysql2": "3.24.6",
        "vitest": "4.1.12"
    },
    "peerDependencies": {
        "@stamhoofd/backend-i18n": "workspace:*",
        "@stamhoofd/email": "workspace:*",
        "@stamhoofd/queues": "workspace:*",
        "@stamhoofd/sql": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.6"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
