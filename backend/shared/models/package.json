{
    "name": "@stamhoofd/models",
    "version": "2.153.4",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": [
        "./src/models/_relations.ts",
        "./dist/models/_relations.js"
    ],
    "exports": {
        ".": "./dist/index.js",
        "./*.ts": "./dist/*.js",
        "./*.js": "./dist/*.js"
    },
    "imports": {
        "#*": "./src/*.ts",
        "#*.ts": "./src/*.ts"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json && mkdir -p ./dist/migrations && rsync --delete --exclude='*.ts' --exclude='*.js' --exclude='*.map' -r --checksum ./src/migrations/ ./dist/migrations/ && rsync -r --checksum ./src/assets/ ./dist/assets/",
        "lint": "eslint",
        "typecheck": "tsc --build tsconfig.test.json",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1140.0",
        "@aws-sdk/client-sesv2": "3.1140.0",
        "@bwip-js/node": "4.11.4",
        "@simonbackx/simple-database": "1.40.1",
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-endpoints": "1.22.0",
        "@simonbackx/simple-errors": "1.5.0",
        "argon2": "0.45.1",
        "base-x": "3.0.11",
        "handlebars": "4.7.9",
        "luxon": "3.7.2",
        "sharp": "0.35.4",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@types/luxon": "3.7.5",
        "@types/uuid": "8.3.4",
        "mysql2": "3.24.4",
        "vitest": "4.1.11"
    },
    "peerDependencies": {
        "@stamhoofd/backend-i18n": "workspace:*",
        "@stamhoofd/email": "workspace:*",
        "@stamhoofd/queues": "workspace:*",
        "@stamhoofd/sql": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "mysql2": "3.24.4"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
