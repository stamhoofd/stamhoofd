{
    "name": "@stamhoofd/backend-i18n",
    "version": "2.159.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./*": {
            "types": "./dist-types/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "dist-types"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "oxlint . --quiet --type-aware --threads 2"
    },
    "dependencies": {
        "@node/endpoints": "workspace:*",
        "@node/logging": "workspace:*",
        "@stamhoofd/locales": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*"
    },
    "devDependencies": {
        "oxlint-plugin-stamhoofd": "workspace:*"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
