{
    "name": "@stamhoofd/vies",
    "version": "2.157.1",
    "type": "module",
    "main": "./dist/ViesService.js",
    "types": "./dist-types/ViesService.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/ViesService.d.ts",
            "import": "./dist/ViesService.js",
            "require": "./dist/ViesService.js"
        },
        "./PeppolDirectoryService.js": {
            "types": "./dist-types/PeppolDirectoryService.d.ts",
            "import": "./dist/PeppolDirectoryService.js",
            "require": "./dist/PeppolDirectoryService.js"
        }
    },
    "files": [
        "dist",
        "dist-types"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint --quiet",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@common/encoding": "workspace:*",
        "@common/errors": "workspace:*",
        "@stamhoofd/models": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "axios": "1.20.0",
        "jsvat-next": "3.0.4"
    },
    "devDependencies": {
        "@node/database": "workspace:*",
        "@stamhoofd/backend-i18n": "workspace:*",
        "@stamhoofd/test-utils": "workspace:*",
        "mysql2": "3.24.6",
        "nock": "14.0.17",
        "vitest": "4.1.12"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
