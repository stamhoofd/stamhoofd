{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": ["tsconfig*.json", "shared/tsconfig*.json", "backend/tsconfig*.json", "frontend/tsconfig*.json", "jest-extended.d.ts", "shared/*.d.ts", "backend/*.d.ts", "frontend/*.d.ts", ".nvmrc", "eslint.config.js", "frontend/eslint.config.js", "backend/eslint.config.js"],
    "cacheDir": ".turbo/cache",
    "tasks": {
        "build": {
            "dependsOn": ["^build", "build:types"],
            "cache": false,
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"]
        },
        "build:types": {
            "dependsOn": ["^build:types"],
            "outputs": ["dist-types/**", ".cache/types*.tsbuildinfo"]
        },
        "@stamhoofd/backend#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/types#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@common/errors#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@common/encoding#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@common/networking#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@node/endpoints#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/test-utils#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/utility#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/metabase#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/cli#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "i18n-uuid#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/stdsync#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "//#build:stam-devops": {
            "dependsOn": ["@stamhoofd/metabase#build", "@stamhoofd/queues#build", "@stamhoofd/structures#build", "@stamhoofd/types#build", "@stamhoofd/utility#build"],
            "inputs": ["devops/src/**", "devops/cli/**", "devops/tsconfig*.json", "devops/package.json", "devops/pnpm-lock.yaml", "environment.d.ts"],
            "outputs": ["devops/dist/**", "devops/dist-cli/**", "devops/*.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/excel-writer#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/structures#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/sgv#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/object-differ#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/locales#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true,
            "env": ["LANG", "LC_ALL"]
        },
        "@stamhoofd/queues#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/backend-env#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/backend-i18n#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/filters#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/sql#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/email#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/models#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/vies#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/logging#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/crons#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "@stamhoofd/backend-middleware#build": {
            "dependsOn": ["^build", "build:types"],
            "outputs": ["dist/**", ".cache/build.tsbuildinfo"],
            "cache": true
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["build:types", "check-inputs", "eslint-plugin-stamhoofd#check-inputs", "@stamhoofd/components#build:types", "@stamhoofd/components#check-inputs"],
            "cache": true,
            "outputs": [],
            "env": ["NODE_ENV"]
        },
        "check-inputs": {
            "dependsOn": ["^check-inputs"]
        },
        "typecheck": {
            "dependsOn": ["build:types", "check-inputs", "@stamhoofd/components#build:types", "@stamhoofd/components#check-inputs"],
            "cache": true,
            "outputs": [".cache/typecheck*.tsbuildinfo"]
        },
        "test": {
            "cache": false
        },
        "test:coverage": {
            "cache": false
        },
        "migrations": {
            "cache": false
        },
        "build:playwright": {
            "cache": false
        }
    }
}
