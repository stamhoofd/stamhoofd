{
    "name": "docs",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare:observability": "pnpm --filter @node/nuxt-observability... run build:types && pnpm --filter @node/nuxt-observability... run build",
        "build": "pnpm run prepare:observability && nuxt build",
        "generate": "pnpm run prepare:observability && nuxt generate",
        "preview": "nuxt preview"
    },
    "dependencies": {
        "@node/nuxt-observability": "workspace:*",
        "@node/observability": "workspace:*",
        "@nuxt/content": "3.16.2",
        "@stamhoofd/assets": "workspace:*",
        "@stamhoofd/scss": "workspace:*",
        "docus": "5.15.0",
        "better-sqlite3": "12.11.1",
        "nuxt": "4.6.3"
    },
    "devDependencies": {
        "@node/dev-tools": "workspace:*",
        "eslint-plugin-stamhoofd": "workspace:*",
        "sass": "1.107.0",
        "vite-svg-2-webfont": "8.5.0"
    }
}
