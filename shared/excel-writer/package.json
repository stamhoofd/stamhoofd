{
    "name": "@stamhoofd/excel-writer",
    "version": "2.157.1",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./core": {
            "types": "./dist-types/core.d.ts",
            "import": "./dist/core.js",
            "require": "./dist/core.js"
        }
    },
    "files": [
        "dist",
        "dist-types",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint --quiet"
    },
    "dependencies": {
        "@common/errors": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "luxon": "3.7.2",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@stamhoofd/types": "workspace:*",
        "@types/archiver": "6.0.4",
        "@types/luxon": "3.7.6"
    },
    "peerDependencies": {
        "archiver": "7.0.1"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
