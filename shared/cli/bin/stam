#!/usr/bin/env bash

dir="$PWD"
while root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; do
    if git -C "$root" remote -v | grep -Eq '[@/]github[.]com[:/]stamhoofd/stamhoofd([.]git)?[[:space:]]'; then
        exec pnpm --dir "$root" --silent run stam "$@"
    fi
    dir="${root%/*}"
    [ -n "$dir" ] || break
done

echo 'stam: not inside a repository with a stamhoofd/stamhoofd GitHub remote' >&2
exit 1
