{
    "name": "@stamhoofd/cli",
    "version": "2.159.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "exports": {
        "./test-events": {
            "types": "./dist-types/runtime/test-events.d.ts",
            "import": "./dist/runtime/test-events.js"
        },
        ".": {
            "types": "./dist-types/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "bin",
        "dev",
        "dist",
        "dist-types",
        "package.json"
    ],
    "bin": {
        "stam": "NODE_OPTIONS=--use-system-ca ./bin/stam.js"
    },
    "scripts": {
        "build": "rm -rf dist .cache/build.tsbuildinfo && tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "oxlint . --quiet --type-aware --threads 2",
        "test": "vitest run",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.137.0",
        "@aws-sdk/client-s3": "3.1160.0",
        "@common/opentelemetry-decorators": "workspace:*",
        "@inquirer/prompts": "7.10.1",
        "@node/dev-tools": "workspace:*",
        "@node/opentelemetry-process": "workspace:*",
        "@node/opentelemetry-terminal": "workspace:*",
        "@node/terminal": "workspace:*",
        "@oclif/core": "4.14.0",
        "@oclif/plugin-autocomplete": "3.3.0",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
        "@opentelemetry/sdk-node": "0.300.0",
        "@opentelemetry/sdk-trace": "3.0.0",
        "@stamhoofd/metabase": "workspace:*",
        "@stamhoofd/stdsync": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "chalk": "5.6.2",
        "i18n-uuid": "workspace:*",
        "openai": "4.104.0",
        "terminal-link": "4.0.0",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "oxlint-plugin-stamhoofd": "workspace:*",
        "vitest": "4.1.12"
    },
    "license": "UNLICENSED",
    "oclif": {
        "bin": "stam",
        "description": "Stamhoofd development CLI",
        "commands": "./dist/commands",
        "helpClass": "./dist/help.js",
        "topicSeparator": " ",
        "plugins": [
            "@oclif/plugin-autocomplete"
        ],
        "theme": {
            "sectionHeader": "cyan",
            "command": "cyan",
            "commandSummary": "white",
            "flag": "yellow",
            "flagDefaultValue": "dim",
            "flagOptions": "dim",
            "flagRequired": "yellow",
            "flagSeparator": "dim",
            "bin": "green",
            "dollarSign": "dim",
            "topic": "cyan",
            "sectionDescription": "white",
            "version": "magenta"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
