{
    "name": "@stamhoofd/structures",
    "version": "2.155.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": [
        "./src/circular-dependencies/*.ts",
        "./src/index.ts",
        "./dist/circular-dependencies/*.js",
        "./dist/index.js",
        "./src/Version.ts",
        "./dist/Version.js"
    ],
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist-types/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "imports": {
        "#*.ts": "./src/*.ts",
        "#*": "./src/*.ts"
    },
    "files": [
        "dist",
        "dist-types",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental false",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@simonbackx/simple-encoding": "2.26.11",
        "uuid": "14.0.2"
    },
    "devDependencies": {
        "@simonbackx/simple-errors": "1.5.0",
        "@stamhoofd/excel-writer": "workspace:*",
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "@types/uuid": "8.3.4",
        "vitest": "4.1.11"
    },
    "peerDependencies": {
        "@simonbackx/simple-errors": "1.5.0",
        "@stamhoofd/excel-writer": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
