{
    "name": "@stamhoofd/metabase",
    "version": "2.155.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "report"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "lint": "eslint",
        "typecheck": "tsc --project tsconfig.build.json --noEmit --composite false --incremental false && tsc --project tsconfig.test.json --noEmit --composite false --incremental false",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "vitest": "4.1.11"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
