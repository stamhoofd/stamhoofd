{
    "name": "@stamhoofd/utility",
    "version": "2.156.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*.js": {
            "types": "./dist-types/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "dist-types",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint . --quiet",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@stamhoofd/types": "workspace:*",
        "ibantools": "4.5.4",
        "jsvat-next": "3.0.4",
        "luxon": "3.7.2"
    },
    "devDependencies": {
        "@types/luxon": "3.7.6",
        "vitest": "4.1.11"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
