{
    "name": "@stamhoofd/criminal-record-check",
    "version": "2.157.1",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*.js": {
            "types": "./dist-types/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist",
        "dist-types",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "lint": "eslint --quiet",
        "typecheck": "tsc --project tsconfig.test.json --noEmit --composite false --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
        "test": "vitest",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@common/errors": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "unpdf": "1.9.1"
    },
    "devDependencies": {
        "vitest": "4.1.12"
    },
    "license": "UNLICENCED",
    "publishConfig": {
        "access": "public"
    }
}
