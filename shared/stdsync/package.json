{
    "name": "@stamhoofd/stdsync",
    "version": "2.158.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist-types/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "dist-types",
        "package.json"
    ],
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "example": "pnpm run build && node examples/live-output.mjs",
        "lint": "eslint . --quiet",
        "test": "vitest run"
    },
    "dependencies": { "@node/terminal": "workspace:*" },
    "devDependencies": {
        "vitest": "4.1.12"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "UNLICENSED"
}
