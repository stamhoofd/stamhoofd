{
    "name": "@stamhoofd/playwright",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc --build",
        "lint": "eslint",
        "test": "pnpm run build && NODE_OPTIONS=--use-system-ca NODE_ENV=test STAMHOOFD_ENV=playwright DEBUG=pw:browser* playwright test -c dist",
        "test:extra": "PLAYWRIGHT_INCLUDE_EXTRA=1 pnpm run test --grep @extra",
        "test:trace": "pnpm run test --trace on"
    },
    "dependencies": {
        "@simonbackx/simple-database": "1.40.1",
        "@stamhoofd/backend": "workspace:*",
        "@stamhoofd/backend-i18n": "workspace:*",
        "@stamhoofd/cli": "workspace:*",
        "@stamhoofd/email": "workspace:*",
        "@stamhoofd/models": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "@simonbackx/simple-encoding": "*",
        "pino": "10.1.1",
        "mysql2": "3.24.4"
    },
    "devDependencies": {
        "@playwright/test": "1.60.0",
        "@stamhoofd/test-utils": "workspace:*",
        "eslint-plugin-stamhoofd": "workspace:*",
        "nock": "14.0.17",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
    }
}
