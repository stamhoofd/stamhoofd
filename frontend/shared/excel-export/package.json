{
    "name": "@stamhoofd/frontend-excel-export",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts",
        "./*.vue": "./src/*.vue"
    },
    "imports": {
        "#*.vue": "./src/*.vue",
        "#*.ts": "./src/*.ts",
        "#*": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint --quiet",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "@common/encoding": "workspace:*",
        "@simonbackx/vue-app-navigation": "2.25.1",
        "@stamhoofd/excel-writer": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "eslint-plugin-stamhoofd": "workspace:*"
    }
}
