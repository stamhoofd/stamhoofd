{
    "name": "@stamhoofd/frontend-application",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint --quiet",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "@simonbackx/simple-encoding": "2.26.11",
        "@common/errors": "workspace:*",
        "@simonbackx/simple-networking": "1.23.0",
        "@simplewebauthn/browser": "13.3.0",
        "@stamhoofd/frontend-i18n": "workspace:*",
        "@stamhoofd/frontend-notifications": "workspace:*",
        "@stamhoofd/frontend-platform": "workspace:*",
        "@stamhoofd/frontend-session": "workspace:*",
        "@stamhoofd/frontend-storage": "workspace:*",
        "@stamhoofd/networking": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@simonbackx/vue-app-navigation": "2.25.1",
        "@stamhoofd/vite-config": "workspace:*",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vite": "8.3.4",
        "vitest": "4.1.12"
    }
}
