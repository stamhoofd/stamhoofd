{
    "name": "@stamhoofd/sgv-frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts",
        "./*.vue": "./src/*.vue"
    },
    "imports": {
        "#*": "./src/*.ts",
        "#*.vue": "./src/*.vue",
        "#*.ts": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint --quiet",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "@stamhoofd/frontend-application": "workspace:*",
        "@stamhoofd/frontend-session": "workspace:*",
        "@stamhoofd/frontend-storage": "workspace:*",
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-errors": "1.5.0",
        "@simonbackx/simple-networking": "1.23.0",
        "@simonbackx/vue-app-navigation": "2.25.1",
        "@stamhoofd/assets": "workspace:*",
        "@stamhoofd/components": "workspace:*",
        "@stamhoofd/networking": "workspace:*",
        "@stamhoofd/sgv": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/vite-config": "workspace:*",
        "@vue/test-utils": "2.5.1",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vite": "8.3.4",
        "vitest": "4.1.12",
        "vitest-browser-vue": "2.1.0"
    }
}
