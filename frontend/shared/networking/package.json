{
    "name": "@stamhoofd/networking",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts",
        "./*.vue": "./src/*.vue"
    },
    "imports": {
        "#*.vue": "./src/*.vue",
        "#*.ts": "./src/*.ts",
        "#*": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-errors": "1.5.0",
        "@simonbackx/simple-networking": "1.23.0",
        "@simonbackx/vue-app-navigation": "2.25.1",
        "@simplewebauthn/browser": "13.3.0",
        "@stamhoofd/components": "workspace:*",
        "@stamhoofd/frontend-i18n": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "vue": "3.5.43",
        "file-saver": "2.0.5"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/vite-config": "workspace:*",
        "@types/file-saver": "2.0.7",
        "@vitest/browser": "4.1.11",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vite": "8.3.1",
        "vitest": "4.1.11",
        "vitest-browser-vue": "2.1.0"
    }
}
