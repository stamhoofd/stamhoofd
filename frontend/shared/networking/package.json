{
    "name": "@stamhoofd/networking",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts",
        "./*.vue": "./src/*.vue"
    },
    "imports": {
        "#*.vue": "./src/*.vue",
        "#*.ts": "./src/*.ts",
        "#*": "./src/*.ts"
    },
    "scripts": {
        "lint": "eslint --quiet",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "@stamhoofd/frontend-notifications": "workspace:*",
        "@common/encoding": "workspace:*",
        "@common/errors": "workspace:*",
        "@common/networking": "workspace:*",
        "@browser/navigation": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@stamhoofd/test-utils": "workspace:*",
        "@stamhoofd/vite-config": "workspace:*",
        "@vitest/browser": "4.1.12",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vite": "8.3.5",
        "vitest": "4.1.12",
        "vitest-browser-vue": "2.1.0"
    }
}
