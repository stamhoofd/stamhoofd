{
    "name": "@stamhoofd/frontend-notifications",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./*": "./src/*.ts",
        "./*.ts": "./src/*.ts"
    },
    "scripts": {
