{
    "name": "@stamhoofd/mobile",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "android": "cap open android",
        "assets:android": "node scripts/generate-android-icons.mjs",
        "build": "NODE_OPTIONS=\"--max-old-space-size=8192 --max-semi-space-size=128\" NODE_ENV=development ENV_FILE=../../.env.json vite build",
        "build:production": "NODE_OPTIONS=\"--max-old-space-size=8192 --max-semi-space-size=128\" NODE_ENV=production vite build",
        "ios": "cap open ios",
        "lint": "eslint --quiet",
        "serve": "NODE_ENV=development ENV_FILE=../../.env.json vite",
        "sync": "cap sync",
        "sync:production": "pnpm run trapeze && cap sync",
        "trapeze": "trapeze run config.yaml -y && trapeze run entitlements.yaml -y && trapeze run display-name.yaml -y",
        "typecheck": "vue-tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo"
    },
    "dependencies": {
        "@stamhoofd/frontend-platform": "workspace:*",
        "@stamhoofd/frontend-storage": "workspace:*",
        "@capacitor-community/in-app-review": "8.0.0",
        "@capacitor/android": "8.5.3",
        "@capacitor/app": "8.1.2",
        "@capacitor/app-launcher": "8.0.1",
        "@capacitor/assets": "3.0.5",
        "@capacitor/core": "8.5.3",
        "@capacitor/device": "8.0.3",
        "@capacitor/filesystem": "8.1.5",
        "@capacitor/haptics": "8.0.2",
        "@capacitor/ios": "8.5.3",
        "@capacitor/keyboard": "8.0.6",
        "@capacitor/preferences": "8.0.1",
        "@capacitor/share": "8.0.3",
        "@capacitor/status-bar": "8.0.4",
        "@capgo/capacitor-updater": "8.53.0",
        "@common/encoding": "workspace:*",
        "@common/networking": "workspace:*",
        "@browser/navigation": "workspace:*",
        "@stamhoofd/assets": "workspace:*",
        "@stamhoofd/components": "workspace:*",
        "@stamhoofd/dashboard": "workspace:*",
        "@stamhoofd/document-helper": "workspace:*",
        "@stamhoofd/web-app": "workspace:*",
        "@stamhoofd/frontend-excel-export": "workspace:*",
        "@stamhoofd/frontend-i18n": "workspace:*",
        "@stamhoofd/frontend-pdf-builder": "workspace:*",
        "@stamhoofd/networking": "workspace:*",
        "@stamhoofd/scss": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/ticket-builder": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "@plausible-analytics/tracker": "0.4.6",
        "vue": "3.5.44",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
    },
    "devDependencies": {
        "@capacitor/cli": "8.5.3",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/vite-config": "workspace:*",
        "@trapezedev/configure": "7.1.10",
        "eslint-plugin-stamhoofd": "workspace:*",
        "sharp": "0.35.5",
        "vite": "8.3.5"
    },
    "resolutions": {
        "@trapezedev/project": "7.1.10"
    }
}
