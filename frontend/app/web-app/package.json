{
    "name": "@stamhoofd/web-app",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "./src/exports.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm run typecheck && NODE_OPTIONS=\"--max-old-space-size=8192 --max-semi-space-size=128\" NODE_ENV=development ENV_FILE=../../.env.json vite build",
        "build:playwright": "NODE_ENV=test STAMHOOFD_ENV=playwright vite build",
        "build:production": "pnpm run typecheck && NODE_OPTIONS=\"--max-old-space-size=8192 --max-semi-space-size=128\" NODE_ENV=production vite build",
        "dev": "NODE_ENV=development ENV_FILE=../../.env.json vite",
        "lint": "eslint",
        "test": "pnpm run typecheck",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@simonbackx/simple-encoding": "2.26.11",
        "@simonbackx/simple-errors": "1.5.0",
        "@simonbackx/vue-app-navigation": "2.25.1",
        "@stamhoofd/admin-frontend": "workspace:*",
        "@stamhoofd/assets": "workspace:*",
        "@stamhoofd/auto": "workspace:*",
        "@stamhoofd/components": "workspace:*",
        "@stamhoofd/dashboard": "workspace:*",
        "@stamhoofd/document-helper": "workspace:*",
        "@stamhoofd/frontend-excel-export": "workspace:*",
        "@stamhoofd/frontend-i18n": "workspace:*",
        "@stamhoofd/frontend-pdf-builder": "workspace:*",
        "@stamhoofd/networking": "workspace:*",
        "@stamhoofd/registration": "workspace:*",
        "@stamhoofd/scss": "workspace:*",
        "@stamhoofd/structures": "workspace:*",
        "@stamhoofd/ticket-builder": "workspace:*",
        "@stamhoofd/types": "workspace:*",
        "@stamhoofd/utility": "workspace:*",
        "@stamhoofd/verify-email": "workspace:*",
        "@plausible-analytics/tracker": "0.4.6",
        "qr-scanner": "1.4.2",
        "vue": "3.5.43"
    },
    "devDependencies": {
        "@stamhoofd/vite-config": "workspace:*",
        "eslint-plugin-stamhoofd": "workspace:*",
        "vite": "8.3.1"
    }
}
