    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "build:types": "tsc --project tsconfig.types.json",
        "test": "vitest run",
        "lint": "eslint --quiet",
        "test:coverage": "vitest --coverage"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "0.135.0",
        "@google/generative-ai": "0.24.1",
        "@mistralai/mistralai": "1.15.1",
        "chalk": "4.1.2",
        "dotenv": "16.6.1",
        "eslint": "10.13.0",
        "eslint-plugin-stamhoofd": "workspace:*",
        "fast-xml-parser": "5.11.2",
        "openai": "4.104.0",
        "typescript": "5.9.3",
        "uuid": "14.0.3",
        "vitest": "4.1.12",
        "winston": "3.19.0"
    }
}
