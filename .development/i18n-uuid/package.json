{
    "name": "i18n-uuid",
    "version": "1.0.0",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "exports": {
        "./replace-keys": "./dist/replace-keys/replace-keys.js",
        "./merge-duplicates": "./dist/replace-keys/merge-duplicates.js",
        "./unused-keys": "./dist/replace-keys/unused-keys.js",
        "./auto-translate": "./dist/auto-translate/auto-translate.js",
        "./translator-type": "./dist/enums/TranslatorType.js"
    },
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "tsc --build tsconfig.build.json",
        "start": "pnpm run build && node --enable-source-maps ./dist/index.js start",
        "replace-text": "pnpm run build && node --enable-source-maps ./dist/index.js replace-text",
        "unused-keys": "pnpm run build && node --enable-source-maps ./dist/index.js unused-keys",
        "merge-duplicates": "pnpm run build && node --enable-source-maps ./dist/index.js merge-duplicates",
        "compress-uuids": "pnpm run build && node --enable-source-maps ./dist/index.js compress-uuids",
        "clear-cache": "pnpm run build && node --enable-source-maps ./dist/index.js clear-cache",
        "replace-keys": "pnpm run build && node --enable-source-maps ./dist/index.js replace-keys",
        "auto-translate": "pnpm run build && node --enable-source-maps ./dist/index.js auto-translate",
        "filter-invalid-auto-translations": "pnpm run build && node --enable-source-maps ./dist/index.js filter-invalid-auto-translations",
        "loop-invalid-auto-translations": "pnpm run build && node --enable-source-maps ./dist/index.js loop-invalid-auto-translations",
        "fix-double-translations": "pnpm run build && node --enable-source-maps ./dist/index.js fix-double-translations",
        "create-comparison": "pnpm run build && node --enable-source-maps ./dist/index.js create-comparison",
        "test": "vitest",
        "lint": "eslint",
        "test:coverage": "vitest --coverage"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "0.124.0",
        "@google/generative-ai": "0.24.1",
        "@mistralai/mistralai": "1.15.1",
        "chalk": "4.1.2",
        "commander": "13.1.0",
        "dotenv": "16.6.1",
        "eslint": "10.10.0",
        "eslint-plugin-stamhoofd": "workspace:*",
        "fast-xml-parser": "5.11.1",
        "openai": "4.104.0",
        "typescript": "5.9.3",
        "uuid": "14.0.2",
        "vitest": "4.1.11",
        "winston": "3.19.0"
    }
}
