{
    "name": "i18n-uuid",
    "version": "1.0.0",
    "type": "module",
    "exports": {
        "./progress": {
            "types": "./dist-types/shared/progress.d.ts",
            "default": "./dist/shared/progress.js"
        },
        "./replace-keys": {
            "types": "./dist-types/replace-keys/replace-keys.d.ts",
            "default": "./dist/replace-keys/replace-keys.js"
        },
        "./merge-duplicates": {
            "types": "./dist-types/replace-keys/merge-duplicates.d.ts",
            "default": "./dist/replace-keys/merge-duplicates.js"
        },
        "./unused-keys": {
            "types": "./dist-types/replace-keys/unused-keys.d.ts",
            "default": "./dist/replace-keys/unused-keys.js"
        },
        "./auto-translate": {
            "types": "./dist-types/auto-translate/auto-translate.d.ts",
            "default": "./dist/auto-translate/auto-translate.js"
        },
        "./translator-type": {
            "types": "./dist-types/enums/TranslatorType.d.ts",
            "default": "./dist/enums/TranslatorType.js"
        },
        "./globals": {
            "types": "./dist-types/shared/globals.d.ts",
            "default": "./dist/shared/globals.js"
        },
        "./translation-manager": {
            "types": "./dist-types/auto-translate/TranslationManager.d.ts",
            "default": "./dist/auto-translate/TranslationManager.js"
        },
        "./replace-text": {
            "types": "./dist-types/replace-text/replace-text.d.ts",
            "default": "./dist/replace-text/replace-text.js"
        },
        "./post-validator": {
            "types": "./dist-types/auto-translate/AutoTranslatorPostValidator.d.ts",
            "default": "./dist/auto-translate/AutoTranslatorPostValidator.js"
        },
        "./file-cache": {
            "types": "./dist-types/replace-text/FileCache.d.ts",
            "default": "./dist/replace-text/FileCache.js"
        },
        "./compress-uuids": {
            "types": "./dist-types/replace-keys/compress-uuids.d.ts",
            "default": "./dist/replace-keys/compress-uuids.js"
        },
        "./fix-double-translations": {
            "types": "./dist-types/auto-translate/fix-double-translations.d.ts",
            "default": "./dist/auto-translate/fix-double-translations.js"
        },
        "./create-comparison": {
            "types": "./dist-types/auto-translate/create-auto-translate-comparison.d.ts",
            "default": "./dist/auto-translate/create-auto-translate-comparison.js"
        }
